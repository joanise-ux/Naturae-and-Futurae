# Strony, które nie mają jeszcze odpowiednika w redesignie. Nawigacja stron -nf
# wciąż do nich linkuje (konto 15x, produkt 6x, panel-klienta 5x, historia 1x).
# Zamiast 404 pokazujemy zaślepkę wyjaśniającą zakres podglądu.
#
# Kod 200 = przepisanie, nie przekierowanie: adres w pasku zostaje, więc
# recenzent widzi, dokąd link prowadził.
/konto.html            /poza-podgladem.html   200
/konto-en.html         /poza-podgladem.html   200
/panel-klienta.html    /poza-podgladem.html   200
/panel-klienta-en.html /poza-podgladem.html   200
/produkt.html          /poza-podgladem.html   200
/historia.html         /poza-podgladem.html   200
/historia-en.html      /poza-podgladem.html   200

# --- Panel klienta (rozdz. 8A) — ładne adresy -----------------------------
#
# Serwis jest statyczny i nie ma routera, więc pięć widoków panelu to pięć
# plików. Ładny adres robi przepisanie 200: pasek adresu pokazuje /konto,
# przeglądarka dostaje konto-nf.html.
#
# Panel jest w whiteliście netlify/build.sh i działa na podglądzie na
# danych przykładowych (zaślepka supabase-config.js), więc otwiera się
# bez logowania i nie sięga do produkcyjnej bazy.
/konto/logowanie          /konto-logowanie-nf.html   200
/konto                    /konto-nf.html             200
/konto/zamowienia         /konto-zamowienia-nf.html  200
/konto/zamowienia/:nr     /konto-zamowienie-nf.html?nr=:nr  200
/konto/dane               /konto-dane-nf.html        200
/konto/ulubione           /konto-ulubione-nf.html    200

